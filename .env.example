# Plantilla de configuracion local.  Copiala a `.env` (que esta gitignoreado).
#
# Los valores de aqui apuntan a la base de desarrollo de docker-compose.dev.yml.
# NO pongas credenciales de Railway en `.env`: van en `.env.production`, que se
# carga a proposito y por comando.  Ver docs/desarrollo-local.md.

# ---- Database ----
POSTGRES_SERVER=localhost
POSTGRES_PORT=55433
POSTGRES_USER=revenew
POSTGRES_PASSWORD=revenew
POSTGRES_DB=revenew_dev

# El schema local se llama db_local a proposito, no db_v2.  Si una conexion
# mal dirigida llegara a Railway con esta configuracion, db_local no existe
# alla: la conexion falla en vez de escribir sobre datos reales.
POSTGRES_SCHEMA=db_local

# En Railway se prefiere DATABASE_URL, o las PG* de abajo.  Cualquiera de las
# dos tiene prioridad sobre las POSTGRES_* (ver app/core/config.py).
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# PGHOST=...
# PGUSER=...
# PGPASSWORD=...
# PGDATABASE=...
# PGPORT=5432

# ---- CORS ----
# Production locks CORS to FRONTEND_PRODUCTION_ORIGIN by default.
# Set ENVIRONMENT=development for local browser-based frontend work.
ENVIRONMENT=development
FRONTEND_PRODUCTION_ORIGIN=http://localhost:5174
# Optional explicit override as a JSON array.
# Example: ["http://localhost:5173","https://frontend.web.app"]
# BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# ---- Firebase ----
# Path to your Firebase Admin SDK service account JSON file
FIREBASE_CREDENTIALS_PATH=./firebase-adminsdk.json
