# ---- Database ----
# Preferred in Railway: set DATABASE_URL, or PG* variables below
# DATABASE_URL=postgresql://user:password@host:5432/dbname
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=dev_db
POSTGRES_PORT=5432

# Railway-style PostgreSQL variables (optional alternative)
# PGHOST=...
# PGUSER=...
# PGPASSWORD=...
# PGDATABASE=...
# PGPORT=5432

# ---- CORS ----
# Production locks CORS to FRONTEND_PRODUCTION_ORIGIN by default.
# Set ENVIRONMENT=development for local browser-based frontend work.
ENVIRONMENT=production
FRONTEND_PRODUCTION_ORIGIN=https://frontend.web.app
# Optional explicit override as a JSON array.
# Example: ["http://localhost:5173","https://frontend.web.app"]
# BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# ---- Firebase ----
# Path to your Firebase Admin SDK service account JSON file
FIREBASE_CREDENTIALS_PATH=./firebase-adminsdk.json
