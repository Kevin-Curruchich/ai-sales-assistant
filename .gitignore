# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*.pyo

# Environment variables
.env

# Virtual environment
venv/
.env/
*.env

# Logs
*.log
*.out
*.err

# OS generated files
.DS_Store
Thumbs.db

# Python package files
*.egg
*.egg-info/
dist/
build/
*.egg-info/

# Cache files
*.cache
*.coverage
*.pytest_cache/
.pytest_cache/
.cache/

# IDE specific files
.vscode/
.idea/

# Uvicorn reload artifacts
*.reload

# Langchain and Langgraph checkpoints
*.checkpoint
*.ckpt

# Miscellaneous
*.bak
*.swp
*.tmp

# Ignore the firebase-adminsdk.json file which contains sensitive credentials
revenew-*-firebase-adminsdk-*-*.json

# Credenciales por entorno.  `.env` y `*.env` no cubren `.env.production`
# ni `.env.local`: el patron `*.env` exige que el nombre TERMINE en `.env`.
.env.*
!.env.example
