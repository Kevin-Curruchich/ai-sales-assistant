# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*.pyo

# Environment variables
.env

# Virtual environment
venv/
.env/
*.env

# Logs
*.log
*.out
*.err

# OS generated files
.DS_Store
Thumbs.db

# Python package files
*.egg
*.egg-info/
dist/
build/
*.egg-info/

# Cache files
*.cache
*.coverage
*.pytest_cache/
.pytest_cache/
.cache/

# IDE specific files. De .vscode/ se versionan solo la configuracion del
# proyecto (formato, interprete, tests) y las extensiones recomendadas.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# Uvicorn reload artifacts
*.reload

# Langchain and Langgraph checkpoints
*.checkpoint
*.ckpt

# Miscellaneous
*.bak
*.swp
*.tmp

# Ignore the firebase-adminsdk.json file which contains sensitive credentials
revenew-*-firebase-adminsdk-*-*.json

# Credenciales por entorno.  `.env` y `*.env` no cubren `.env.production`
# ni `.env.local`: el patron `*.env` exige que el nombre TERMINE en `.env`.
.env.*
!.env.example

# Salida de graphify.  El grafo se construye leyendo la carpeta entera y la
# herramienta no documenta redaccion de secretos: si alguna vez se corre desde
# la raiz, lo que haya leido no debe terminar en el repo.
graphify-out/

# Export de Fleet: los identificadores de la plataforma (tenant, organizacion,
# proveedor de OAuth) no van al repo.  Las skills y AGENTS.md si se versionan,
# como referencia de dominio -- ver Revenew/README.md.
Revenew/config.json
Revenew/tools.json

# venv aparte para el CLI de LangGraph (ver docs/agente.md): sus dependencias
# son incompatibles con las de la API.
.venv-agent/

# Estado local del servidor de desarrollo de LangGraph.
.langgraph_api/
