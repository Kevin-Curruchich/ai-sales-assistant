{
  // Oculta la caché de bytecode de Python del explorador y de la búsqueda.
  // Los archivos siguen en disco; esto es solo presentación.
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.pytest_cache": true
  },

  // Intérprete: el venv del proyecto (Python 3.13). Sin esto Pylance no
  // resuelve fastapi, langgraph, app.*, etc. y subraya todos los imports.
  "python.defaultInterpreterPath": "${workspaceFolder}/venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "python.envFile": "${workspaceFolder}/.env",

  // Pylance
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.extraPaths": ["${workspaceFolder}"],
  "python.analysis.exclude": ["**/venv", "**/graphify-out", "**/.langgraph_api", "**/Revenew"],

  // Tests (pytest, desde la raíz para que `app.*` sea importable)
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],

  // Formato y lint con Ruff (en vez de autopep8). La configuracion vive en
  // pyproject.toml; `fromEnvironment` usa el Ruff fijado en
  // requirements-dev.txt (el del venv) en vez del que trae la extension, asi
  // el editor, pre-commit y CI formatean con la misma version.
  "ruff.importStrategy": "fromEnvironment",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  "python-envs.defaultEnvManager": "ms-python.python:system"
}
